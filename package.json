{
  "name": "design3d",
  "version": "0.1.0",
  "private": true,
  "description": "design3d.pl — Stair Studio (konfigurator 3D schodów) + panel administracyjny Lead Discovery",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --experimental-strip-types --experimental-sqlite --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --experimental-strip-types --experimental-sqlite --disable-warning=ExperimentalWarning --watch src/server.ts",
    "build": "npm ci --prefix configurator --include=dev --no-audit --no-fund && npm run build --prefix configurator",
    "test": "node --experimental-strip-types --experimental-sqlite --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:configurator": "npm test --prefix configurator",
    "typecheck": "tsc --noEmit",
    "scan": "node --experimental-strip-types --experimental-sqlite --disable-warning=ExperimentalWarning src/cli/scan.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "robots-parser": "^3.0.1",
    "tldts": "^7.4.19",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
