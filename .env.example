# --- Serwer ---
PORT=3000
# Hasło do panelu administracyjnego (HTTP Basic Auth, login: admin). WYMAGANE w produkcji.
ADMIN_USER=admin
ADMIN_PASSWORD=zmien-mnie
DATABASE_PATH=./data/design3d.sqlite

# --- Crawler ---
# Identyfikacja bota (przestrzegamy robots.txt dla tego User-Agenta i dla "*")
CRAWLER_USER_AGENT=Design3dLeadBot/1.0 (+https://design3d.pl/bot)
CRAWLER_BOT_TOKEN=Design3dLeadBot
# Ile firm skanujemy równolegle
CRAWL_CONCURRENCY=6
# Minimalny odstęp między żądaniami do tego samego hosta (ms); Crawl-delay z robots.txt ma pierwszeństwo, jeśli większy
PER_HOST_DELAY_MS=1500
REQUEST_TIMEOUT_MS=15000
MAX_PAGE_BYTES=2500000
# Pamięć podręczna stron – nie pobieramy ponownie strony młodszej niż X godzin
PAGE_CACHE_HOURS=168
# Playwright – renderowanie JS tylko gdy potrzebne (true/false)
ENABLE_JS_RENDERING=true

# --- Wyszukiwarki (opcjonalne, płatne) ---
# Brave Search API: https://api.search.brave.com
BRAVE_SEARCH_API_KEY=
BRAVE_COST_PER_QUERY_USD=0.005
# Google Programmable Search (Custom Search JSON API)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_COST_PER_QUERY_USD=0.005

# --- Analiza AI (opcjonalna, płatna) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
# Cena USD za 1M tokenów (do szacowania kosztów)
ANTHROPIC_INPUT_PRICE_PER_MTOK=4
ANTHROPIC_OUTPUT_PRICE_PER_MTOK=20
AI_CONCURRENCY=2

# --- RODO / retencja ---
# Po ilu dniach bez ponownej weryfikacji dane firmy są usuwane
RETENTION_DAYS=730
# Co ile dni ponownie weryfikujemy kontakty
REVERIFY_DAYS=90
DATA_CONTROLLER_NAME=design3d.pl
DATA_CONTROLLER_CONTACT=rodo@design3d.pl
